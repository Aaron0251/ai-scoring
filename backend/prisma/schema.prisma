// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["ai_scoring"]
}

// ─────────────────────────────────────────────
// 組織架構
// ─────────────────────────────────────────────

model Division {
  id                 Int                @id @default(autoincrement())
  name               String             @unique
  departments        Department[]
  deptPersons        DeptPerson[]
  users              User[]
  resourceCategories ResourceCategory[]
  resourceTools      ResourceTool[]
  createdAt          DateTime           @default(now())

  @@schema("ai_scoring")
}

model Department {
  id             Int            @id @default(autoincrement())
  name           String
  divisionId     Int
  division       Division       @relation(fields: [divisionId], references: [id])
  sections       Section[]
  scenes         Scene[]
  deptPersons    DeptPerson[]
  users          User[]
  resourceTools      ResourceTool[]
  resourceCategories ResourceCategory[]
  createdAt          DateTime       @default(now())

  @@unique([name, divisionId])
  @@schema("ai_scoring")
}

model Section {
  id                 Int                @id @default(autoincrement())
  name               String
  departmentId       Int
  department         Department         @relation(fields: [departmentId], references: [id])
  scenes             Scene[]
  deptPersons        DeptPerson[]
  users              User[]
  resourceCategories ResourceCategory[]
  resourceTools      ResourceTool[]
  createdAt          DateTime           @default(now())

  @@unique([name, departmentId])
  @@schema("ai_scoring")
}

// ─────────────────────────────────────────────
// 主管名單（供指派直屬主管用）
// ─────────────────────────────────────────────

model DeptPerson {
  id           Int         @id @default(autoincrement())
  name         String
  title        String      @default("")
  divisionId   Int?
  division     Division?   @relation(fields: [divisionId], references: [id])
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  sectionId    Int?
  section      Section?    @relation(fields: [sectionId], references: [id])
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  @@schema("ai_scoring")
}

// ─────────────────────────────────────────────
// 使用者
// ─────────────────────────────────────────────

model User {
  id                 Int         @id @default(autoincrement())
  username           String      @unique
  password           String?     // AD 帳號不存密碼，系統帳號才有值
  name               String
  roles              String      // JSON Array 字串，如 ["admin"] 或 ["evaluator","chief"]
  divisionId         Int?
  division           Division?   @relation(fields: [divisionId], references: [id])
  departmentId       Int?
  department         Department? @relation(fields: [departmentId], references: [id])
  sectionId          Int?
  section            Section?    @relation(fields: [sectionId], references: [id])
  mustChangePassword Boolean     @default(false)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@schema("ai_scoring")
}

// ─────────────────────────────────────────────
// 總機關首長 / 本部主管
// ─────────────────────────────────────────────

model OrgChief {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   // 總機關首長 | 本部主管
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@schema("ai_scoring")
}

// ─────────────────────────────────────────────
// AI 場景
// ─────────────────────────────────────────────

model Scene {
  id                  Int        @id @default(autoincrement())
  itemNo              String     @unique // 系統自動編號，如 AI-0001
  departmentId        Int
  department          Department @relation(fields: [departmentId], references: [id])
  sectionId           Int?
  section             Section?   @relation(fields: [sectionId], references: [id])

  sceneName           String     // 最多 100 字
  maintainOrDevelop   String?    // 維持 | 開發 | 作廢
  itAssisted          Boolean?   // 是否由資訊協助完成

  developMethod       String?
  developToolDesc     String?
  agentCategory       String?    // Agent類型

  inputDesc           String?
  outputDesc          String?
  taskSteps           String?
  rawDataExample      String?
  finalDataExample    String?

  timePerExecution    String?    // 每次執行耗費時間（文字，如「30分鐘」）
  monthlyFrequency    String?    // 每月執行頻率（文字，如「每週3次」）
  demandCount         Int?       // 需求人次

  taskOwners          String?    // 執行人員（逗號分隔或JSON）
  seedOwners          String?    // 種子人員

  priority            String     @default("中")    // 高 | 中 | 低
  status              String     @default("規劃中") // 規劃中 | 進行中 | 已完成 | 暫停
  progress            Int        @default(0)        // 0-100

  establishDate       DateTime?
  targetDate          DateTime?
  goLiveDate          DateTime?
  completedAt         DateTime?  // 狀態首次變為「已完成」的時間（自動記錄，不覆寫）
  baselineSavingHours Float?     // 變為「已完成」當下的 savingHoursMonthly（只寫一次）

  originalHours       Float?     // 原總作業時數
  improvedHours       Float?     // 改善後總作業時數
  savingHoursMonthly  Float?     // 預估節省時數（月）：直接填入值，優先於 originalHours-improvedHours
  originalHeadcount   Int?       // 原總作業人數
  improvedHeadcount   Int?       // 改善後總作業人數
  // efficiencyGainPct 為計算欄，由 API 動態回傳

  resultText          String?
  actualResultText    String?
  otherMetrics        String?

  note                String?
  active              Boolean    @default(true)
  importHash          String?    @unique // Excel 匯入防重複
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  resourceCategoryId  Int?
  resourceCategory    ResourceCategory? @relation("SceneResourceCategory", fields: [resourceCategoryId], references: [id], onDelete: SetNull)
  resourceTool        ResourceTool?     @relation("SceneResourceTool")

  benefits            SceneBenefit[]
  executionLogs       SceneExecutionLog[]
  actualSavings       SceneActualSavings[]
  progressHistories   SceneProgressHistory[]

  @@schema("ai_scoring")
}

model SceneActualSavings {
  id        Int    @id @default(autoincrement())
  sceneId   Int
  scene     Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  year      Int
  jan       Float?
  feb       Float?
  mar       Float?
  apr       Float?
  may       Float?
  jun       Float?
  jul       Float?
  aug       Float?
  sep       Float?
  oct       Float?
  nov       Float?
  dec       Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sceneId, year])
  @@schema("ai_scoring")
}

// ─────────────────────────────────────────────
// 場景每日執行紀錄
// ─────────────────────────────────────────────

model SceneExecutionLog {
  id        Int      @id @default(autoincrement())
  sceneId   Int
  scene     Scene    @relation(fields: [sceneId], references: [id])
  logDate   DateTime // 執行日期
  executor  String?  // 執行人員姓名
  content   String   // 執行內容說明
  status    String   @default("完成") // 完成 | 進行中 | 暫停 | 待辦
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("ai_scoring")
}

model SceneBenefit {
  id          Int      @id @default(autoincrement())
  sceneId     Int
  scene       Scene    @relation(fields: [sceneId], references: [id])
  benefitType String   // 效益分類
  description String?
  value       Float?
  unit        String?
  createdAt   DateTime @default(now())

  @@schema("ai_scoring")
}

// ─────────────────────────────────────────────
// 角色功能權限設定
// ─────────────────────────────────────────────

model RolePermission {
  id         Int      @id @default(autoincrement())
  role       String   // admin | manager | chief | executive
  featureKey String   // 對應 features.js 中的 key
  allowed    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([role, featureKey])
  @@schema("ai_scoring")
}

// ─────────────────────────────────────────────
// 系統設定
// ─────────────────────────────────────────────

model SystemConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@schema("ai_scoring")
}

// ─────────────────────────────────────────────
// Excel 匯入進度追蹤
// ─────────────────────────────────────────────

model ExcelImportLog {
  id          Int      @id @default(autoincrement())
  filename    String
  uploadedBy  Int      // User.id
  totalRows   Int
  successRows Int
  failedRows  Int
  errors      String?  // JSON 字串
  status      String   // processing | done | failed
  createdAt   DateTime @default(now())

  @@schema("ai_scoring")
}

// ─────────────────────────────────────────────
// 成果資源庫
// ─────────────────────────────────────────────

model ResourceCategory {
  id           Int            @id @default(autoincrement())
  name         String
  description  String?
  divisionId   Int?           // 本部層級
  division     Division?      @relation(fields: [divisionId], references: [id])
  departmentId Int?           // 部門層級
  department   Department?    @relation(fields: [departmentId], references: [id])
  sectionId    Int?           // 課別層級
  section      Section?       @relation(fields: [sectionId], references: [id])
  sortOrder    Int            @default(0)
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tools        ResourceTool[]
  scenes       Scene[]        @relation("SceneResourceCategory")

  @@schema("ai_scoring")
}

model ResourceTool {
  id           Int               @id @default(autoincrement())
  name         String
  description  String?
  categoryId   Int?              // nullable = 未分類
  category     ResourceCategory? @relation(fields: [categoryId], references: [id])
  sceneId      Int?              @unique  // 關聯場景（已完成自動建立）
  scene        Scene?            @relation("SceneResourceTool", fields: [sceneId], references: [id], onDelete: SetNull)
  divisionId   Int?
  division     Division?        @relation(fields: [divisionId], references: [id])
  departmentId Int?
  department   Department?      @relation(fields: [departmentId], references: [id])
  sectionId    Int?
  section      Section?         @relation(fields: [sectionId], references: [id])
  sortOrder    Int              @default(0)
  active       Boolean          @default(true)
  createdBy    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  items        ResourceItem[]
  favorites    UserFavorite[]

  @@schema("ai_scoring")
}

model ResourceItem {
  id          Int          @id @default(autoincrement())
  toolId      Int
  tool        ResourceTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  name        String       // 項目名稱，如：操作說明書、官方網站
  itemType    String       // url | pdf | excel | video | image | text
  url         String?      // 網址連結（itemType = url 時使用）
  filePath    String?      // 上傳檔案原始檔名（含副檔名，供下載命名；實際內容存於 fileData）
  fileData    Bytes?       // 上傳檔案內容（存資料庫，避免 Cloud Run 暫時磁碟重啟後遺失）
  fileSize    Int?         // 檔案大小（bytes）
  mimeType    String?
  description String?
  sortOrder   Int          @default(0)
  active      Boolean      @default(true)
  createdBy   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@schema("ai_scoring")
}

model UserFavorite {
  id         Int          @id @default(autoincrement())
  userId     Int          // User.id
  toolId     Int
  tool       ResourceTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  folderName String?      // 個人最愛資料夾名稱（可選）
  sortOrder  Int          @default(0)
  createdAt  DateTime     @default(now())

  @@unique([userId, toolId])
  @@schema("ai_scoring")
}

// ─────────────────────────────────────────────
// 場景進度變動歷史
// ─────────────────────────────────────────────

model SceneProgressHistory {
  id            Int      @id @default(autoincrement())
  sceneId       Int
  scene         Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  progressValue Int      // 進度百分比 0-100
  changedAt     DateTime // 變更時間戳
  changedBy     String?  // 變更者帳號
  remarks       String?  // 備註（可選）
  createdAt     DateTime @default(now())

  @@index([sceneId])
  @@index([changedAt])
  @@schema("ai_scoring")
}
